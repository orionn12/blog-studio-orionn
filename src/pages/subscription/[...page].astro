---
import type { GetStaticPaths } from "astro";
import CategoryHeader from "@components/CategoryHeader.astro";
import Pagination from "@components/control/Pagination.astro";
import PostPage from "@components/PostPage.astro";
import { CATEGORIES } from "@constants/categories";
import { PAGE_SIZE } from "@constants/constants";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getPostsByCategory } from "../../utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const posts = await getPostsByCategory("subscription");
	return paginate(posts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const cat = CATEGORIES["subscription"];
const { page } = Astro.props;
const allPosts = await getPostsByCategory("subscription");
const len = page.data.length;
---

<MainGridLayout title={cat.label}>
	<CategoryHeader slug="subscription" postCount={allPosts.length} />
	<PostPage page={page} />
	<Pagination
		class="mx-auto onload-animation"
		page={page}
		style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
	/>
</MainGridLayout>
